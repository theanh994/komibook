APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=komibook
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=localhost
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
FILESYSTEM_LOCAL_ROOT=
FILESYSTEM_PUBLIC_ROOT=
FILESYSTEM_PRIVATE_ROOT=

# Production release safety gate (non-secret)
PRODUCTION_DATABASE_NAME=komibook
PRODUCTION_HOST=komibook.id.vn
PRODUCTION_SHARED_ROOT=C:/komibook_shared
PRODUCTION_MIN_USERS=1
PRODUCTION_MIN_BOOKS=1
PRODUCTION_MIN_VENDORS=1
PRODUCTION_MIN_ORGANIZATIONS=1
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://example.com/api/vnpay/return
VNPAY_REFUND_URL=https://sandbox.vnpayment.vn/merchant_webapi/api/transaction
# Chỉ bật ở local khi không có URL IPN công khai; production phải giữ false.
VNPAY_CONFIRM_ON_RETURN=false

# Chỉ hỗ trợ COD, VNPAY Sandbox và Ví KomiBook giả lập.
PAYMENT_EXTERNAL_CALLS_ENABLED=false
VNPAY_MODE=sandbox
DEMO_WALLET_MODE=disabled
DEMO_SHIPPING_CARRIER="KomiBook Express (mô phỏng)"
DEMO_SHIPPING_TRACKING_PREFIX=KBX

# Gemini chatbot is disabled by default. Configure an explicit allowlist before enabling it.
GEMINI_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_ALLOWED_MODELS=
GEMINI_MAX_ATTEMPTS=1
GEMINI_CONNECT_TIMEOUT=3
GEMINI_TIMEOUT=12
GEMINI_MAX_OUTPUT_TOKENS=1200

VITE_APP_NAME="${APP_NAME}"
